# Application Config
spring.application.name=mp-trip-planner
server.port=8080

# Database Configuration (H2 in-memory mode for zero-setup execution)
spring.datasource.url=jdbc:h2:mem:mptourismdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=MySQL
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=${DB_USERNAME:sa}
spring.datasource.password=${DB_PASSWORD:}
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# For MySQL Database (uncomment and configure environment variables for Production MySQL):
# spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:mp_tourism_db}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver
# spring.datasource.username=${DB_USERNAME:root}
# spring.datasource.password=${DB_PASSWORD:root}

# JPA / Hibernate Configuration
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# File Upload Settings
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Security, JWT & AI Key Configuration
jwt.secret=${JWT_SECRET:YOUR_SECURE_JWT_SECRET_KEY_HERE}
jwt.expiration=${JWT_EXPIRATION:86400000}

# LLM / AI API Configuration
ai.llm.api-key=${AI_API_KEY:YOUR_AI_SERVICE_API_KEY_HERE}
ai.llm.api-url=${AI_API_URL:https://api.openai.com/v1/chat/completions}
